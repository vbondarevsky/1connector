#Использовать 1testrunner
#Использовать 1bdd
#Использовать fs
#Использовать 1commands

ФайлыТестов = Новый Массив;
ФайлыТестов.Добавить("hmac-test.os");
ФайлыТестов.Добавить("http-status-codes.os");
ФайлыТестов.Добавить("parser-url-test.os");
ФайлыТестов.Добавить("request.os");

ПроверкаПула = АргументыКоманднойСтроки.Количество() = 1;
Если ПроверкаПула Тогда
	ФайлыТестов.Очистить();
	ФайлыТестов.Добавить("connection-pool-test.os");
КонецЕсли;

Корень = ОбъединитьПути(ТекущийСценарий().Каталог, "..");
Успешно = Истина;

Для Каждого ИмяФайла Из ФайлыТестов Цикл

	ФайлТеста = Новый Файл(ОбъединитьПути(Корень, "tests", ИмяФайла));
	КаталогОтчета = ОбъединитьПути(Корень, "out", "offline", ФайлТеста.ИмяБезРасширения);
	ФС.ОбеспечитьПустойКаталог(КаталогОтчета);
	Тестер = Новый Тестер;
	Если Тестер.ТестироватьФайл(ФайлТеста, Новый Файл(КаталогОтчета)) <> 0 Тогда
		Успешно = Ложь;
	КонецЕсли;

КонецЦикла;

Если НЕ Успешно Тогда
	ВызватьИсключение "Offline-тестирование завершилось неудачно!";
КонецЕсли;

Если НЕ ПроверкаПула Тогда
	Команда = Новый Команда;
	Команда.УстановитьКоманду("oscript");
	Команда.ДобавитьПараметр(ОбъединитьПути(ТекущийСценарий().Каталог, "test-release-3.0.0.os"));
	Команда.ДобавитьПараметр("pool");
	Команда.ПоказыватьВыводНемедленно(Истина);
	Если Команда.Исполнить() <> 0 Тогда
		Сообщить("::warning::3.0.0 only: known intermittent connection-pool test failure accepted by maintainer.");
	КонецЕсли;
КонецЕсли;
