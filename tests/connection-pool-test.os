#Использовать "../src"
#Использовать "../src/internal"

// BSLLS:UnusedParameters-off
Функция ПолучитьСписокТестов(МенеджерТестирования) Экспорт
// BSLLS:UnusedParameters-on
	МассивТестов = Новый Массив;
	МассивТестов.Добавить("ТестДолжен_ПроверитьЧтоПулПереживаетПараллельныеВызовы");
	Возврат МассивТестов;
КонецФункции

Процедура ТестДолжен_ПроверитьЧтоПулПереживаетПараллельныеВызовы() Экспорт

	Пул = Новый ПулСоединений;

	Задания = Новый Массив;
	Для Номер = 1 По 8 Цикл
		Параметры = Новый Массив;
		Параметры.Добавить(Пул);
		Параметры.Добавить(Номер * 1000);
		Задания.Добавить(ФоновыеЗадания.Выполнить(ЭтотОбъект, "ПолучатьСоединения", Параметры));
	КонецЦикла;

	Для Каждого Задание Из Задания Цикл
		Задание.ОжидатьЗавершения(60000);
		Если Задание.Состояние = СостояниеФоновогоЗадания.ЗавершеноАварийно Тогда
			ВызватьИсключение Задание.ИнформацияОбОшибке.Описание;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Процедура ПолучатьСоединения(Пул, ПервыйПорт) Экспорт

	Для Порт = ПервыйПорт По ПервыйПорт + 200 Цикл
		ПараметрыСоединения = Новый Структура;
		ПараметрыСоединения.Вставить("Схема", "http");
		ПараметрыСоединения.Вставить("Сервер", "localhost");
		ПараметрыСоединения.Вставить("Порт", Порт);
		ПараметрыСоединения.Вставить("Пользователь", "");
		ПараметрыСоединения.Вставить("Пароль", "");
		ПараметрыСоединения.Вставить("Прокси", Неопределено);
		ПараметрыСоединения.Вставить("Таймаут", 1);
		Пул.Получить(ПараметрыСоединения);
	КонецЦикла;

КонецПроцедуры
